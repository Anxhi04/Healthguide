# Optional: omit ALL three values to use credentials/firebase-admin.json.
# To override that file, supply all three from the same Firebase service account.
# FIREBASE_PROJECT_ID=healthconnect-caec4
# FIREBASE_CLIENT_EMAIL=your-service-account@healthconnect-caec4.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
PORT=5000

# Public origin for locally stored images. Use the LAN address for physical devices.
PUBLIC_BACKEND_URL=http://192.168.100.48:5000
